# Production Environment Configuration
# Copy this file to .env.prod and fill in the values

# Database Configuration
DATABASE_NAME=emailagent
DATABASE_USER=emailagent
DATABASE_PASSWORD=your-secure-password-here
DATABASE_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# API Configuration
API_PORT=8000

# Application Secrets
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32
OPENAI_API_KEY=sk-your-openai-api-key-here

# S3 Storage Configuration
S3_BUCKET=your-s3-bucket-name
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://s3.amazonaws.com

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Gmail API (OAuth2 service account)
GMAIL_CREDENTIALS_PATH=/path/to/gmail-credentials.json

# Monitoring & Error Tracking
# Sentry DSN for error tracking (optional but recommended for production)
# Get your DSN from https://sentry.io/settings/projects/
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Release tracking (optional, automatically set in CI/CD)
# GIT_COMMIT_SHA=abc123
# VERSION=1.0.0

# Optional: Custom domain
# API_DOMAIN=api.your-domain.com
